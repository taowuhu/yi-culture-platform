{
  "name": "yi-culture-platform",
  "version": "0.4.0",
  "description": "一个以确定性术数计算、传统原典和现代移动体验为基础的东方传统知识 App。",
  "private": true,
  "scripts": {
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:h5": "npm run dev:h5 --workspace=mobile",
    "doctor": "npx expo-doctor apps/mobile",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspace=@yi-culture/domain && npm run typecheck --workspace=@yi-culture/iching && npm run typecheck --workspace=mobile",
    "web": "npm run web --workspace=mobile"
  },
  "workspaces": ["apps/*", "packages/*"],
  "keywords": ["易经", "周易", "起卦", "传统文化", "确定性", "术数", "移动应用"],
  "repository": {
    "type": "git",
    "url": "https://github.com/EXAMPLE/yi-culture-platform.git"
  },
  "bugs": {"url": "https://github.com/EXAMPLE/yi-culture-platform/issues"},
